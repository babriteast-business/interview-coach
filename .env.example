# LOCAL USE ONLY. Copy to .env. On Render you set these in the Environment tab instead.
OPENROUTER_API_KEY=sk-or-v1-paste-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODELS=openrouter/free,auto
ADMIN_USERNAME=babrit.admin
ADMIN_PASSWORD=change-me
# Leave empty to use local SQLite. Paste your Neon Postgres URL to share data with the website.
DATABASE_URL=
PORT=8000
MOCK_LLM=0
